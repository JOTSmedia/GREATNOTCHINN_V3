-  display: block; width: 18px; height: 2px; background: #fff; position: relative; content: "";
-}
-.nav-toggle-bars::before { position: absolute; top: -6px; }
-.nav-toggle-bars::after { position: absolute; top: 6px; }
-
-/* Hero kicker + call-to-action row */
-.kicker {
-  color: var(--accent-yellow); font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase;
-  text-align: center; font-size: clamp(1rem, 2.6vw, 1.25rem); margin: 0 0 6px 0; line-height: 1.35;
-}
-.cta-row { display: flex; flex-wrap: wrap; gap: 10px; margin: 14px 0 6px; }
-.cta-btn {
-  display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
-  padding: 10px 16px; border-radius: 10px; font-weight: 900; letter-spacing: 0.04em;
-  text-transform: uppercase; text-decoration: none; color: #fff; font-size: 0.92rem;
-  background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.22);
-}
-.cta-btn.cta-call { background: linear-gradient(180deg, var(--molten-start), var(--molten-end)); border-color: transparent; }
-.cta-btn:hover { color: #fff !important; filter: brightness(1.12); text-decoration: none; }
-
-/* Events list: title is a real button */
-.event-link {
-  background: none; border: 0; padding: 0; margin: 0; color: #fff; font: inherit; font-weight: 700;
-  text-align: left; cursor: pointer;
-}
-.event-link:hover { text-decoration: underline; }
-.event-time { color: var(--accent-yellow); }
-button.toggle { display: block; margin: 10px auto 0; background: none; border: 0; font: inherit; font-weight: 800; }
-
-/* Mobile bottom action bar */
-.action-bar { display: none; }
-
-/* Touch screens: show the merch call-to-action without hover */
-@media (hover: none) {
-  figure .overlay { opacity: 1; background: linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(0,0,0,0.8) 100%); }
-}
-
-@media (max-width: 900px) {
-  #site-nav {
-    justify-content: space-between; align-items: center; flex-wrap: wrap;
-    padding: 8px 12px; min-height: 56px;
-    backdrop-filter: none; -webkit-backdrop-filter: none; background: rgba(0, 0, 0, 0.94);
-  }
-  #site-nav .brand {
-    display: block; color: #ff3b3b; font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase;
-    font-size: 1rem; padding: 6px 0; background: none;
-  }
-  .nav-toggle { display: inline-flex; }
-  #site-nav .nav-inner { display: none; }
-  #site-nav.open .nav-inner {
-    display: flex; flex-direction: column; align-items: stretch; gap: 0; width: 100%;
-    padding: 8px 0 4px; max-height: calc(100vh - 70px); overflow-y: auto;
-  }
-  #site-nav.open .nav-inner a { padding: 12px 8px; border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 1rem; }
-  #site-nav a:hover { transform: none; }
-  .live-tonight { display: none; }
-  .parallax { padding-top: 80px; }
-
-  .action-bar {
-    display: grid; grid-template-columns: repeat(3, 1fr); position: fixed; left: 0; right: 0; bottom: 0; z-index: 1300;
-    background: rgba(0, 0, 0, 0.96); border-top: 1px solid rgba(255, 255, 255, 0.15);
-    padding-bottom: env(safe-area-inset-bottom);
-  }
-  .action-bar a {
-    display: flex; align-items: center; justify-content: center; min-height: 52px;
-    color: #fff; font-weight: 900; text-transform: uppercase; letter-spacing: 0.05em; text-decoration: none; font-size: 0.9rem;
-  }
-  .action-bar a + a { border-left: 1px solid rgba(255, 255, 255, 0.12); }
-  .action-bar .action-live { background: linear-gradient(180deg, var(--molten-start), var(--molten-end)); }
-  body { padding-bottom: calc(52px + env(safe-area-inset-bottom)); }
-  .cta-btn { flex: 1 1 calc(50% - 10px); }
-}
-
-@media (max-width: 600px) {
-  .timeline { flex-direction: column; overflow-x: visible; }
-  .tl-item { min-width: 0; flex: 0 0 auto; }
-}
-
-@media (max-width: 420px) {
-  .form-row { flex-direction: column; align-items: stretch; }
-  .form-field { flex: 0 0 auto; min-width: 0; width: 100%; }
-  .cta-btn { flex: 1 1 100%; }
-}
-
-/* Skip layout/paint work for sections until they come near the screen (faster first load on phones).
-   Turned off (html.cv-off) as soon as someone uses an in-page link, so jumps land in the right place. */
-html:not(.cv-off) .parallax:not(#home), html:not(.cv-off) #contact { content-visibility: auto; contain-intrinsic-size: auto 1200px; }
-
-/* ==========================================================================
-   Confirmed hours lines and press PDF archive (seo-facts branch)
-   ========================================================================== */
-.hours-line { margin: 6px 0; line-height: 1.5; }
-.hours-line a { color: var(--accent-cyan); }
-.press-archive { margin-top: 28px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.1); }
-.press-archive h3 { font-size: 1.1rem; margin: 0 0 8px; }
-.press-pdf-list { margin: 10px 0 0; padding-left: 20px; line-height: 1.7; text-align: left; }
-.press-pdf-list a { color: var(--accent-cyan); }
-.pdf-note { color: #aaa; font-size: 0.85em; }
-
-/* Tonight's act card (text swapped by js/app.js; fixed height = no layout shift) */
-.static-band-card.tonight-card { border-color: var(--molten-start); background: rgba(153, 0, 0, 0.25); }
-.tonight-card a { display: flex; flex-direction: column; justify-content: center; height: 4em; padding: 0 6px; overflow: hidden; }
-.tonight-card .tonight-label { display: block; font-size: 0.72rem; letter-spacing: 0.12em; color: var(--accent-cyan); line-height: 1.3; }
-/* up to 2 lines, then ellipsis; height is reserved for 2 lines so 1-line vs 2-line text never shifts layout */
-.tonight-card .tonight-act { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; line-height: 1.25; }
